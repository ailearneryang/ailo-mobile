    "test:ios-config": "node --test scripts/ios-bundle-output.test.cjs scripts/ios-standalone.test.cjs",
    "test:markdown": "node --test scripts/markdown.test.cjs",
    "postinstall": "node scripts/speech-native-guard.cjs"
